/* ======================================================
   DMS-Raptor  —  Light Teal Theme
   ====================================================== */

/* --- Base --- */
QMainWindow, QDialog {
    background-color: #f5f5f5;
    color: #333333;
}
QWidget {
    background-color: transparent;
    color: #333333;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #cccccc;
    background-color: #ffffff;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #e8e8e8;
    color: #666666;
    padding: 10px 28px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #cccccc;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #00838f;
    border-bottom: 2px solid #00bcd4;
}
QTabBar::tab:hover:!selected {
    background-color: #f0f0f0;
    color: #444444;
}

/* --- Group boxes --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    margin-top: 14px;
    padding: 18px 12px 12px 12px;
    font-weight: bold;
    color: #00838f;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    color: #00838f;
}

/* --- Buttons --- */
QPushButton {
    background-color: #e8e8e8;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #d0d0d0;
    border-color: #00bcd4;
}
QPushButton:pressed {
    background-color: #00bcd4;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #f0f0f0;
    color: #aaaaaa;
    border-color: #dddddd;
}
QPushButton#runButton {
    background-color: #00897b;
    color: #ffffff;
    border: none;
    font-size: 15px;
    padding: 12px 36px;
    border-radius: 6px;
}
QPushButton#runButton:hover {
    background-color: #00a693;
}
QPushButton#runButton:disabled {
    background-color: #c8e6c9;
    color: #aaaaaa;
}
QPushButton#stopButton {
    background-color: #d32f2f;
    color: #ffffff;
    border: none;
    font-size: 15px;
    padding: 12px 36px;
    border-radius: 6px;
}
QPushButton#stopButton:hover {
    background-color: #e53935;
}
QPushButton#stopButton:disabled {
    background-color: #ffcdd2;
    color: #aaaaaa;
}

/* --- Inputs --- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 6px 8px;
    selection-background-color: #b2ebf2;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #00bcd4;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #b2ebf2;
    border: 1px solid #cccccc;
}

/* --- Checkboxes --- */
QCheckBox {
    spacing: 8px;
    color: #333333;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid #cccccc;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #00bcd4;
    border-color: #00bcd4;
}

/* --- Sliders --- */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #e0e0e0;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    background-color: #00bcd4;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background-color: #00bcd4;
    border-radius: 3px;
}

/* --- Progress bar --- */
QProgressBar {
    background-color: #e0e0e0;
    border: 1px solid #cccccc;
    border-radius: 4px;
    text-align: center;
    color: #333333;
    height: 22px;
}
QProgressBar::chunk {
    background-color: #00bcd4;
    border-radius: 3px;
}

/* --- Tables --- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9f9f9;
    color: #333333;
    gridline-color: #cccccc;
    border: 1px solid #cccccc;
    border-radius: 4px;
    selection-background-color: #b2ebf2;
}
QHeaderView::section {
    background-color: #e8e8e8;
    color: #00838f;
    padding: 6px;
    border: 1px solid #cccccc;
    font-weight: bold;
}

/* --- Scroll bars --- */
QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background-color: #00bcd4; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background-color: #f0f0f0;
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #cccccc;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background-color: #00bcd4; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* --- Labels --- */
QLabel#headerLabel {
    font-size: 22px;
    font-weight: bold;
    color: #00838f;
}
QLabel#subtitleLabel {
    font-size: 12px;
    color: #888888;
}
QLabel#statsValue {
    font-size: 16px;
    font-weight: bold;
    color: #222222;
    font-family: "Consolas", "Courier New", monospace;
}
QLabel#statsKey {
    font-size: 11px;
    color: #888888;
}

/* --- Status bar --- */
QStatusBar {
    background-color: #e8e8e8;
    color: #666666;
    border-top: 1px solid #cccccc;
}

/* --- Menu bar --- */
QMenuBar {
    background-color: #e8e8e8;
    color: #333333;
    border-bottom: 1px solid #cccccc;
}
QMenuBar::item:selected { background-color: #d0d0d0; }
QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
}
QMenu::item:selected { background-color: #b2ebf2; }

/* --- Splitter --- */
QSplitter::handle { background-color: #cccccc; }

/* --- Tooltips --- */
QToolTip {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #00bcd4;
    padding: 5px;
    border-radius: 3px;
}
